# Serveur LAN
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://IP_DU_SERVEUR:3000
CORS_ORIGINS=http://IP_DU_SERVEUR:3000
LAN_ONLY=true

# Securite
JWT_SECRET=change-this-long-random-secret
JWT_EXPIRES_IN=8h
SESSION_TIMEOUT_MINUTES=480
BCRYPT_ROUNDS=12

# Premier administrateur cree au premier lancement si aucun utilisateur n'existe
ADMIN_EMAIL=admin@local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrateur

# Stockage runtime
DATA_DIR=./runtime
BOTS_DIR=./runtime/bots
BACKUPS_DIR=./runtime/backups
LOGS_DIR=./runtime/logs
TEMP_DIR=./runtime/tmp
MAX_UPLOAD_MB=250

# Executables Linux
NPM_BIN=npm
PM2_MAX_MEMORY=350M
